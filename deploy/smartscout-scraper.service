[Unit]
Description=SmartScout T12M Revenue Scraper API
After=network.target

[Service]
# Change User to your actual deploy user (e.g. ubuntu, deploy, etc.)
User=www-data
Group=www-data
WorkingDirectory=/opt/zapier-ss-hs
EnvironmentFile=/opt/zapier-ss-hs/.env
ExecStart=/opt/zapier-ss-hs/venv/bin/gunicorn \
    --workers 2 \
    --bind 0.0.0.0:5055 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile - \
    app:app
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smartscout-scraper

[Install]
WantedBy=multi-user.target
